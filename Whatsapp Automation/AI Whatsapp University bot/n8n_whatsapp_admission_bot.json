        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: $('Config').first().json.ollama_model,\n  prompt: `You are a friendly, professional admission assistant for FAST-NUCES Islamabad, replying over WhatsApp. Use the data below to answer the student's question in 2-5 short sentences. Be warm and helpful. Do not invent facts that are not in the data. If the data says NO_DATA_FOUND, politely say you could not find that specific information and suggest contacting the Admissions Office at admissions.isb@nu.edu.pk or +92-51-111-128-128. Do not use markdown formatting, just plain text suitable for a WhatsApp message.\\n\\nStudent question: \\\"{{$json.text}}\\\"\\n\\nRelevant data:\\n{{$json.contextText}}`,\n  stream: false\n}) }}",
        "options": {
