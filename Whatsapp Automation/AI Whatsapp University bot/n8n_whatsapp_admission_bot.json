        "jsCode": "const ctx = $('Build Context').first().json;\nconst raw = $input.first().json;\nlet replyText = (raw && raw.response) ? String(raw.response).trim() : '';\nif (!replyText) {\n  replyText = 'Sorry, I could not process that right now. Please contact the Admissions Office at admissions.isb@nu.edu.pk or +92-51-111-128-128.';\n}\nreturn [{ json: { to: ctx.from, replyText } }];\n"
