        "jsCode": "const intentData = $('Parse Intent').first().json;\nconst rows = $input.all().map(i => i.json);\nlet contextText = '';\nif (rows.length === 0) {\n  contextText = 'NO_DATA_FOUND';\n} else {\n  contextText = rows.map(r => Object.entries(r)\n    .filter(([k]) => !k.startsWith('_') && k !== 'row_number')\n    .map(([k, v]) => `${k}: ${v}`).join(' | ')).join('\\n');\n}\nreturn [{ json: {\n  ...intentData,\n  contextText\n} }];\n"
      },
