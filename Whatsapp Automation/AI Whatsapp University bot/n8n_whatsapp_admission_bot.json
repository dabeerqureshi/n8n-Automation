    {
      "parameters": {
        "method": "POST",
        "url": "={{$('Config').first().json.ollama_url}}/api/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: $('Config').first().json.ollama_model,\n  prompt: `You are an intent classifier for a university WhatsApp admission bot for FAST-NUCES Islamabad. Classify the student's message into exactly ONE of these intents: general, faq, degree, policy, timetable, scholarship, faculty, calendar, contacts, fallback. Also extract any relevant entities mentioned. Respond ONLY with a valid JSON object, no extra text, no markdown, in this exact shape: {\\\"intent\\\": \\\"<one of the intents above>\\\", \\\"keyword\\\": \\\"<short keyword or empty string>\\\", \\\"degree\\\": \\\"<degree name or empty string>\\\", \\\"department\\\": \\\"<department code or empty string>\\\", \\\"semester\\\": \\\"<semester number or empty string>\\\", \\\"day\\\": \\\"<day of week or empty string>\\\"}. Student message: \\\"{{$json.text}}\\\"`,\n  format: 'json',\n  stream: false\n}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "7e2dafe2-c077-4ce3-adc1-3c5d300ce611",
      "name": "Ollama - Classify Intent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -320,
        20
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const upstream = $('Extract WhatsApp Message').first().json;\nconst raw = $input.first().json;\nlet intent = 'fallback';\nlet keyword = '', degree = '', department = '', semester = '', day = '';\nconst validIntents = ['general','faq','degree','policy','timetable','scholarship','faculty','calendar','contacts','fallback'];\ntry {\n  const modelText = raw.response || '';\n  const parsed = JSON.parse(modelText);\n  if (validIntents.includes(parsed.intent)) intent = parsed.intent;\n  keyword = parsed.keyword || '';\n  degree = parsed.degree || '';\n  department = parsed.department || '';\n  semester = String(parsed.semester || '');\n  day = parsed.day || '';\n} catch (e) {\n  intent = 'fallback';\n}\nreturn [{ json: {\n  intent, keyword, degree, department, semester, day,\n  from: upstream.from, text: upstream.text, contactName: upstream.contactName\n} }];\n"
      },
