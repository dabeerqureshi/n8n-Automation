    {
      "parameters": {
        "jsCode": "const routeData = $input.first().json;\nconst menuText = 'Welcome to ABC Bank \\ud83d\\udc4b\\nPlease choose an option.\\n\\n1\\ufe0f\\u20e3 Bank Balance\\n2\\ufe0f\\u20e3 Bank Statement\\n3\\ufe0f\\u20e3 FAQs\\n4\\ufe0f\\u20e3 Talk to Customer Support\\n\\nReply with the number.';\n\nreturn [{\n  json: {\n    ...routeData,\n    replyText: menuText,\n    newState: 'MAIN_MENU',\n    newLastMenu: '-',\n    newPinAttempts: 0\n  }\n}];"
      },
