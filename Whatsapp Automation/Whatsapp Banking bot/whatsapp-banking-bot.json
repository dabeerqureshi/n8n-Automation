    {
      "parameters": {
        "jsCode": "const incoming = $('Parse WhatsApp Payload').first().json;\nconst sessionRows = $input.all().map(i => i.json).filter(r => r.Phone);\nconst session = sessionRows.length ? sessionRows[0] : null;\n\nconst text = (incoming.text || '').trim();\nconst lower = text.toLowerCase();\n\nlet state = session ? session.State : 'MAIN_MENU';\nlet pinAttempts = session ? Number(session.PinAttempts || 0) : 0;\n\nconst greetings = ['hi', 'hello', 'hey', 'start', 'menu', 'hii', 'salam', 'assalamualaikum'];\n\nlet route = 'MAIN_MENU';\n\nif (!session || greetings.includes(lower)) {\n  route = 'MAIN_MENU';\n  state = 'MAIN_MENU';\n} else if (state === 'MAIN_MENU') {\n  route = ['1', '2', '3', '4'].includes(text) ? 'MENU_SELECTION' : 'INVALID';\n} else if (state === 'WAITING_PIN_BALANCE' || state === 'WAITING_PIN_STATEMENT') {\n  route = 'VALIDATE_PIN';\n} else if (state === 'WAITING_FAQ') {\n  route = 'FAQ';\n} else {\n  route = 'MAIN_MENU';\n  state = 'MAIN_MENU';\n}\n\nreturn [{\n  json: {\n    ...incoming,\n    session,\n    currentState: state,\n    pinAttempts,\n    route\n  }\n}];"
      },
