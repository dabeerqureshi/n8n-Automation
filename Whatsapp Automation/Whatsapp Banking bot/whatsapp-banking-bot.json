    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst text = (data.text || '').trim();\n\nlet replyText = '';\nlet newState = 'MAIN_MENU';\nlet newLastMenu = '-';\n\nswitch (text) {\n  case '1':\n    replyText = 'Please enter your 4-digit PIN to check your balance.';\n    newState = 'WAITING_PIN_BALANCE';\n    newLastMenu = '1';\n    break;\n  case '2':\n    replyText = 'Please enter your 4-digit PIN to view your last statement.';\n    newState = 'WAITING_PIN_STATEMENT';\n    newLastMenu = '2';\n    break;\n  case '3':\n    replyText = 'Please type your banking question and I will do my best to help.';\n    newState = 'WAITING_FAQ';\n    newLastMenu = '3';\n    break;\n  case '4':\n    replyText = '\\ud83d\\udcde Customer Support\\n+1-800-123-4567\\nAvailable 9 AM - 5 PM';\n    newState = 'MAIN_MENU';\n    newLastMenu = '4';\n    break;\n  default:\n    replyText = 'Invalid option. Please reply with 1, 2, 3 or 4.';\n    newState = 'MAIN_MENU';\n    newLastMenu = '-';\n}\n\nreturn [{ json: { ...data, replyText, newState, newLastMenu, newPinAttempts: 0 } }];"
      },
