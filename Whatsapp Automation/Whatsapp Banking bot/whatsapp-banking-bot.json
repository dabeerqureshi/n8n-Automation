    {
      "parameters": {
        "jsCode": "const routeData = $('Determine Route').first().json;\nconst customerRows = $input.all().map(i => i.json).filter(r => r.Phone);\nconst customer = customerRows.find(c => String(c.Phone) === String(routeData.phone));\n\nconst enteredPin = (routeData.text || '').trim();\nconst attempts = Number(routeData.pinAttempts || 0);\nconst menu = routeData.session ? routeData.session.LastMenu : '1';\n\nlet replyText = '';\nlet newState = routeData.currentState;\nlet newPinAttempts = attempts;\nlet newLastMenu = menu;\n\nif (!customer) {\n  replyText = 'We could not find your account. Please contact customer support at +1-800-123-4567.';\n  newState = 'MAIN_MENU';\n  newPinAttempts = 0;\n} else if (String(customer.PIN) === enteredPin) {\n  if (String(menu) === '2') {\n    replyText = `Hello ${customer.Name} \\ud83d\\udc4b\\n\\nLast Statement:\\n${customer.LastStatement}\\n\\nCurrent Balance: $${customer.Balance}\\n\\nReply with:\\n1 Balance | 2 Statement | 3 FAQs | 4 Support`;\n  } else {\n    replyText = `Hello ${customer.Name} \\ud83d\\udc4b\\n\\nAvailable Balance: $${customer.Balance}\\n\\nReply with:\\n1 Balance | 2 Statement | 3 FAQs | 4 Support`;\n  }\n  newState = 'MAIN_MENU';\n  newPinAttempts = 0;\n} else {\n  newPinAttempts = attempts + 1;\n  if (newPinAttempts >= 3) {\n    replyText = 'Too many failed attempts. Please contact customer support at +1-800-123-4567.';\n    newState = 'MAIN_MENU';\n    newPinAttempts = 0;\n  } else {\n    replyText = `Incorrect PIN. Please try again. (${3 - newPinAttempts} attempt(s) left)`;\n    newState = routeData.currentState;\n  }\n}\n\nreturn [{ json: { ...routeData, replyText, newState, newLastMenu, newPinAttempts } }];"
      },
