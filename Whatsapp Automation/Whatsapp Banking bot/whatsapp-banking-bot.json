      "parameters": {
        "jsCode": "const data = $input.first().json;\nlet answer = data.response ? data.response.trim() : 'Please contact customer support.';\n\nconst words = answer.split(/\\s+/);\nif (words.length > 80) {\n  answer = words.slice(0, 80).join(' ') + '...';\n}\n\nconst routeData = $('Determine Route').first().json;\n\nreturn [{\n  json: {\n    ...routeData,\n    replyText: answer,\n    newState: 'WAITING_FAQ',\n    newLastMenu: '3',\n    newPinAttempts: 0\n  }\n}];"
      },
