        -160,
        -100
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\n\ntry {\n  const entry = body.entry[0].changes[0].value;\n  const message = entry.messages ? entry.messages[0] : null;\n\n  if (!message) {\n    // status update (delivered/read) - nothing to reply to\n    return [{ json: { skip: true, reason: 'no_message_or_status_update' } }];\n  }\n\n  const phone = message.from;\n  const messageId = message.id;\n  const timestamp = message.timestamp;\n  let text = '';\n\n  if (message.type === 'text') {\n    text = (message.text.body || '').trim();\n  } else if (message.type === 'interactive' && message.interactive.type === 'button_reply') {\n    text = message.interactive.button_reply.id;\n  } else if (message.type === 'button') {\n    text = message.button.text;\n  } else {\n    text = '';\n  }\n\n  return [{ json: { phone, messageId, timestamp, text, msgType: message.type, skip: false } }];\n} catch (e) {\n  return [{ json: { skip: true, reason: 'parse_error', error: e.message } }];\n}"
      },
