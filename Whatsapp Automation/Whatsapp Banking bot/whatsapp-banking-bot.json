    {
      "parameters": {
        "jsCode": "const routeData = $('Determine Route').first().json;\nconst faqRows = $input.all().map(i => i.json).filter(r => r.Question);\nconst question = (routeData.text || '').toLowerCase();\n\nlet match = null;\nfor (const row of faqRows) {\n  const keywords = (row.Keywords || '').toLowerCase().split(',').map(k => k.trim()).filter(Boolean);\n  const questionText = (row.Question || '').toLowerCase();\n  if (keywords.some(k => k && question.includes(k)) || (questionText && question.includes(questionText))) {\n    match = row;\n    break;\n  }\n}\n\nif (match) {\n  return [{\n    json: {\n      ...routeData,\n      replyText: match.Answer,\n      newState: 'WAITING_FAQ',\n      newLastMenu: '3',\n      newPinAttempts: 0,\n      needAI: false\n    }\n  }];\n}\n\nreturn [{ json: { ...routeData, needAI: true } }];"
      },
