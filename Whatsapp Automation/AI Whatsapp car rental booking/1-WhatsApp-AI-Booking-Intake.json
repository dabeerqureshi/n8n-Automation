      "id": "if-004",
      "name": "IF Booking Ready",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1400, 560]
    },
    {
      "parameters": {
        "jsCode": "// Simple per-car price list (per day). Adjust to your real pricing.\nconst prices = {\n  'Toyota Corolla': 45,\n  'Honda Civic': 50,\n  'Suzuki Alto': 30,\n  'Toyota Hiace': 90\n};\n\nconst booking = $input.first().json.output.booking;\nconst phone = $('Extract Message Fields').item.json.phone;\n\nfunction parseLooseDate(d) {\n  const dt = new Date(d);\n  return isNaN(dt.getTime()) ? new Date() : dt;\n}\n\nconst start = parseLooseDate(booking.pickup_date);\nconst end = parseLooseDate(booking.return_date);\nconst days = Math.max(1, Math.round((end - start) / (1000 * 60 * 60 * 24)));\nconst rate = prices[booking.car] || 40;\nconst total = days * rate;\n\nconst bookingId = 'CR-' + Math.floor(1000 + Math.random() * 9000);\nconst now = new Date().toISOString();\n\nreturn [{\n  json: {\n    bookingId,\n    fullName: booking.full_name,\n    phone,\n    email: booking.email,\n    car: booking.car,\n    pickupDate: booking.pickup_date,\n    returnDate: booking.return_date,\n    pickupLocation: booking.pickup_location,\n    dropoffLocation: booking.dropoff_location,\n    driverRequired: booking.driver_required,\n    totalPrice: total,\n    bookingStatus: 'Pending',\n    adminApproval: 'No',\n    createdAt: now,\n    lastUpdated: now\n  }\n}];\n"
      },
      "id": "code-002",
      "name": "Calculate Price & Booking ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1640, 560]
    },
