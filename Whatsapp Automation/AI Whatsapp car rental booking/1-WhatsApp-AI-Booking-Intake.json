        "responseBody": "EVENT_RECEIVED",
        "options": {"responseCode": 200}
      },
      "id": "resp-003",
      "name": "Respond 200 To Meta",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [380, 460]
    },
    {
      "parameters": {
        "jsCode": "// Safely pull message data out of the WhatsApp Cloud API payload.\n// Non-message events (delivery/read receipts) are dropped here.\nconst body = $input.first().json.body || {};\nconst entry = (body.entry && body.entry[0]) || {};\nconst change = (entry.changes && entry.changes[0]) || {};\nconst value = change.value || {};\nconst msg = (value.messages && value.messages[0]) || null;\nconst contact = (value.contacts && value.contacts[0]) || null;\n\nif (!msg || msg.type !== 'text') {\n  return [{ json: { hasText: false } }];\n}\n\nreturn [{\n  json: {\n    hasText: true,\n    phone: msg.from,\n    messageId: msg.id,\n    messageText: msg.text.body,\n    contactName: contact && contact.profile ? contact.profile.name : 'Customer'\n  }\n}];\n"
      },
      "id": "code-001",
      "name": "Extract Message Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [620, 460]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "loose"},
          "conditions": [
            {
              "id": "cond-has-text",
              "leftValue": "={{$json.hasText}}",
              "rightValue": true,
              "operator": {"type": "boolean", "operation": "true"}
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-003",
      "name": "IF Has Text Message",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [860, 460]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{$json.messageText}}",
        "options": {
          "systemMessage": "You are a car rental booking assistant on WhatsApp for 'City Rentals'.\nYour job is to collect these fields from the customer, one or two at a time, in a friendly and concise way:\n1. full_name\n2. phone (use the WhatsApp sender number automatically, do not ask)\n3. email\n4. car (available cars: Toyota Corolla, Honda Civic, Suzuki Alto, Toyota Hiace)\n5. pickup_date (format: DD Mon YYYY)\n6. return_date (format: DD Mon YYYY)\n7. pickup_location\n8. dropoff_location\n9. driver_required (Yes/No)\n\nRules:\n- Ask only for missing fields, do not repeat questions already answered.\n- Validate return_date is after pickup_date.\n- Once ALL fields are collected, set status to 'ready' and write a short friendly reply confirming submission, e.g. 'Thank you! Your booking request has been submitted and is awaiting approval. We will notify you once it is confirmed.'\n- While still collecting, set status to 'collecting' and ask the next question(s) in 'reply'.\n- Always return your answer using the required JSON schema only, never plain text outside it."
        }
      },
      "id": "agent-001",
      "name": "Booking AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.9,
      "position": [1100, 460]
    },
    {
      "parameters": {
        "model": "llama3.1",
        "options": {"temperature": 0.3}
      },
      "id": "lm-001",
      "name": "Ollama Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [1000, 660],
      "credentials": {
        "ollamaApi": {"id": "1", "name": "Ollama (local)"}
      }
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{$('Extract Message Fields').item.json.phone}}",
        "contextWindowLength": 20
      },
      "id": "mem-001",
      "name": "Session Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [1140, 660]
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"status\": {\"type\": \"string\", \"enum\": [\"collecting\", \"ready\"]},\n    \"reply\": {\"type\": \"string\"},\n    \"booking\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"full_name\": {\"type\": \"string\"},\n        \"email\": {\"type\": \"string\"},\n        \"car\": {\"type\": \"string\"},\n        \"pickup_date\": {\"type\": \"string\"},\n        \"return_date\": {\"type\": \"string\"},\n        \"pickup_location\": {\"type\": \"string\"},\n        \"dropoff_location\": {\"type\": \"string\"},\n        \"driver_required\": {\"type\": \"string\"}\n      }\n    }\n  },\n  \"required\": [\"status\", \"reply\"]\n}"
      },
      "id": "parser-001",
      "name": "Booking Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [1280, 660]
    },
    {
      "parameters": {
        "url": "https://graph.facebook.com/v20.0/REPLACE_WITH_PHONE_NUMBER_ID/messages",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"messaging_product\": \"whatsapp\", \"to\": $('Extract Message Fields').item.json.phone, \"type\": \"text\", \"text\": { \"body\": $json.output.reply } } }}",
        "options": {}
      },
      "id": "http-001",
      "name": "Send WhatsApp Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1400, 340],
      "credentials": {
        "httpHeaderAuth": {"id": "2", "name": "WhatsApp Cloud API Token"}
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "loose"},
          "conditions": [
            {
              "id": "cond-ready",
              "leftValue": "={{$json.output.status}}",
              "rightValue": "ready",
