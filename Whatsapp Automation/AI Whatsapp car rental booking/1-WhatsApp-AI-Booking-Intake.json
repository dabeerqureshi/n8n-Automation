            "Pickup Date": "={{$json.pickupDate}}",
            "Return Date": "={{$json.returnDate}}",
            "Pickup Location": "={{$json.pickupLocation}}",
            "Drop-off Location": "={{$json.dropoffLocation}}",
            "Driver Required": "={{$json.driverRequired}}",
            "Total Price": "={{$json.totalPrice}}",
            "Booking Status": "={{$json.bookingStatus}}",
            "Admin Approval": "={{$json.adminApproval}}",
            "Admin Notes": "",
            "Created At": "={{$json.createdAt}}",
            "Last Updated": "={{$json.lastUpdated}}"
          }
        },
        "options": {}
      },
      "id": "gs-001",
      "name": "Append Booking Row",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1880, 560],
      "credentials": {
        "googleSheetsOAuth2Api": {"id": "3", "name": "Google Sheets account"}
      }
    },
    {
      "parameters": {
        "fromEmail": "bookings@cityrentals.example",
        "toEmail": "admin@cityrentals.example",
        "subject": "=New Booking Request - {{$json['Booking ID']}}",
        "emailFormat": "text",
        "text": "=A new booking request needs your approval.\n\nBooking ID: {{$json['Booking ID']}}\nCustomer: {{$json['Customer Name']}}\nPhone: {{$json['Phone']}}\nEmail: {{$json['Email']}}\nCar: {{$json['Car']}}\nPickup: {{$json['Pickup Date']}} at {{$json['Pickup Location']}}\nReturn: {{$json['Return Date']}} at {{$json['Drop-off Location']}}\nDriver required: {{$json['Driver Required']}}\nTotal Price: {{$json['Total Price']}}\n\nOpen the Bookings sheet and change 'Admin Approval' to Yes to confirm, or set Booking Status to Rejected to decline.",
        "options": {}
      },
