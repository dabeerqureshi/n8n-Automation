    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst routed = $('Parse Intent Result').first().json;\nconst trackingId = (routed.trackingId || '').toUpperCase();\nconst match = rows.find(r => (r['Tracking ID'] || '').toString().toUpperCase() === trackingId);\nreturn [{ json: { found: !!match, data: match || null, trackingId: routed.trackingId, from: routed.from } }];"
      },
      "id": "n23-find-shipment",
      "name": "Find Shipment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2220, -20]
    },
    {
      "parameters": {
        "jsCode": "const d = $json;\nlet message;\nif (!d.found) {\n  message = `Sorry, I couldn't find a shipment with tracking ID ${d.trackingId || '(not provided)'}. Please double check and try again, or type \"talk to support\" for help.`;\n} else {\n  message = `Shipment Found\\n\\nTracking ID: ${d.data['Tracking ID']}\\nStatus: ${d.data['Status']}\\nCourier: ${d.data['Courier']}\\nCurrent Location: ${d.data['Current Location']}\\nExpected Delivery: ${d.data['Expected Delivery']}`;\n  if (d.data['Delay Reason']) {\n    message += `\\nDelay Reason: ${d.data['Delay Reason']}`;\n  }\n}\nreturn [{ json: { to: d.from, message } }];"
      },
