      "id": "n31-ask-cost",
      "name": "Ask Cost Details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2000, 60]
    },
    {
      "parameters": {
        "documentId": { "__rl": true, "value": "={{ $env.GOOGLE_SHEET_ID }}", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Shipping Rates", "mode": "name" },
