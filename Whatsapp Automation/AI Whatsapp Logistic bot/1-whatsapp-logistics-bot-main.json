    {
      "parameters": {
        "jsCode": "const routed = $('Parse Intent Result').first().json;\nconst city = (routed.city || '').toLowerCase();\nconst rows = $input.all().map(i => i.json);\nconst match = rows.find(r => (r['City'] || '').toLowerCase().includes(city) || city.includes((r['City'] || '').toLowerCase()));\n\nlet message;\nif (!city) {\n  message = 'Which city is your nearest branch in? Please tell me your city name.';\n} else if (!match) {\n  message = `Sorry, no branch found for \"${routed.city}\". Please type \"talk to support\" for help.`;\n} else {\n  message = `${match['Courier']} ${match['Branch']} Branch\\n\\nAddress: ${match['Address']}\\nPhone: ${match['Phone']}`;\n}\nreturn [{ json: { to: routed.from, message } }];"
      },
