      "id": "n32-get-rates",
      "name": "Get All Shipping Rates",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [2000, 200]
    },
    {
      "parameters": {
        "jsCode": "const routed = $('Parse Intent Result').first().json;\nconst weight = parseFloat(routed.weight);\nconst destType = routed.destinationType;\nconst rows = $input.all().map(i => i.json);\n\nfunction parseRange(rangeStr) {\n  const m = (rangeStr || '').match(/([\\d.]+)\\s*-\\s*([\\d.]+)/);\n  return m ? [parseFloat(m[1]), parseFloat(m[2])] : null;\n}\n\nlet rate = null;\nfor (const r of rows) {\n  const range = parseRange(r['Weight']);\n  if (range && weight > range[0] && weight <= range[1]) { rate = r; break; }\n}\nif (!rate && rows.length) {\n  const first = parseRange(rows[0]['Weight']);\n  const last = parseRange(rows[rows.length - 1]['Weight']);\n  if (first && weight <= first[1]) rate = rows[0];\n  else if (last && weight > last[0]) rate = rows[rows.length - 1];\n}\n\nconst colMap = { same_city: 'Same City', same_province: 'Same Province', nationwide: 'Nationwide' };\nconst col = colMap[destType] || 'Nationwide';\n\nlet message;\nif (!rate) {\n  message = `Sorry, I couldn't calculate a rate for ${weight}kg. Please contact support for a custom quote.`;\n} else {\n  message = `Shipping Cost Estimate\\n\\nWeight: ${weight}kg\\nDestination: ${(destType || '').replace('_', ' ')}\\nCost: PKR ${rate[col]}`;\n}\n\nreturn [{ json: { to: routed.from, message } }];"
      },
      "id": "n33-format-cost",
      "name": "Format Cost Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2220, 200]
