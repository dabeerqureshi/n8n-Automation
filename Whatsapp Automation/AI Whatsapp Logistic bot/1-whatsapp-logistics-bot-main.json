      "position": [1780, 700]
    },
    {
      "parameters": {
        "jsCode": "const routed = $('Parse Intent Result').first().json;\nconst text = (routed.originalText || '').toLowerCase();\nconst words = text.split(/\\W+/).filter(w => w.length > 2);\nconst rows = $input.all().map(i => i.json);\n\nlet best = null;\nlet bestScore = 0;\nfor (const r of rows) {\n  const q = (r['Question'] || '').toLowerCase();\n  let score = 0;\n  for (const w of words) { if (q.includes(w)) score++; }\n  if (score > bestScore) { bestScore = score; best = r; }\n}\n\nlet message;\nif (best && bestScore > 0) {\n  message = `${best['Question']}\\n${best['Answer']}`;\n} else {\n  message = \"I couldn't find an exact answer to that. Type 'talk to support' and our team will help you directly.\";\n}\nreturn [{ json: { to: routed.from, message } }];"
      },
